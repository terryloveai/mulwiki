# Mulwiki server
PORT=8080
DATABASE_URL=file:mulwiki.db
JWT_SECRET=dev-secret-change-me-in-production
DATA_DIR=./data
BUILTIN_SCHEMAS_DIR=./builtin/schemas
BUILTIN_SKILLS_DIR=./builtin/skills
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Web
MULWIKI_API_URL=http://localhost:8080

# Daemon
DAEMON_POLL_INTERVAL=5s
DAEMON_WORKSPACES_ROOT=./workspaces
DAEMON_SERVER_URL=http://localhost:8080
